# Create-FileSrv.ps1
# This script sets up a file server with shared folders and permissions based on department and user data from a CSV file.

<#Mappestruktur for filserver (E:\Shares):
E:\Shares
├── Faelles
├── Afdelinger
│   ├── Lager
│   │   ├── Nakskov
│   │   └── Aero
