# Når SG er i AD, så kør denne for at få brugerne ind i de rigtige SG
Import-Module ActiveDirectory

$users = Import-Csv -Path "C:\Users\michella_admin\Desktop\prutl-users.csv" -Delimiter ";" -Encoding UTF8

foreach ($user in $users) {
    $sam = $user.Brugernavn.Trim()

    foreach ($group in $user.SecurityGroups -split ",") {
        $group = $group.Trim()

        if ($group -ne "") {
            Add-ADGroupMember `
                -Identity $group `
                -Members $sam `
                -ErrorAction SilentlyContinue

            Write-Host "Tilføjet $sam til $group" -ForegroundColor Cyan
        }
    }
}

